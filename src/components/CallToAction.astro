---
// Bloco final das páginas internas: pedido de orçamento, com o WhatsApp direto como alternativa.
import Section from './layout/Section.astro';
import Button from './ui/Button.astro';
import Eyebrow from './ui/Eyebrow.astro';
import { getDirectContact, getQuoteHref, quoteRequest } from '../utils/contact';
import { getPageName } from '../utils/pages';

const directContact = getDirectContact(await getPageName(Astro.url.pathname));
---

<Section>
  <div class="border-brand-gradient rounded-2xl p-8 sm:p-12">
    <Eyebrow>Próximo passo</Eyebrow>
    <h2 class="mt-3 max-w-2xl font-display text-3xl font-bold tracking-tight sm:text-4xl">
      Vamos conversar sobre o seu projeto?
    </h2>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">
      Conte o que você precisa. A primeira conversa é sem compromisso.
    </p>
    <div class="mt-8 flex flex-wrap gap-4">
      <Button href={getQuoteHref()} event={quoteRequest.event}>
        {quoteRequest.label}
      </Button>
      <Button href={directContact.href} event={directContact.event} variant="secondary" external>
        {directContact.label}
      </Button>
    </div>
  </div>
</Section>
