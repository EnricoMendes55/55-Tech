---
import Section from '../layout/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import ServiceGrid from '../ServiceGrid.astro';
---

<Section id="servicos">
  <SectionHeading
    eyebrow="Serviços"
    title="Soluções digitais completas, do logotipo ao aplicativo."
    description="Contrate um serviço específico ou combine vários em um projeto integrado. Cada um parte de um problema concreto da sua empresa."
  />

  <div class="mt-12">
    <ServiceGrid onHome />
  </div>
</Section>
