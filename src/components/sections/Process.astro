---
import Section from '../layout/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import ProcessSteps from '../ProcessSteps.astro';
import WorkFormats from '../WorkFormats.astro';
---

<Section id="processo">
  <SectionHeading
    eyebrow="Processo"
    title="Como funciona, da primeira conversa à entrega."
    description="Um caminho simples, com escopo combinado antes de começar e sem surpresas no meio."
  />

  <ProcessSteps class="mt-12 lg:grid-cols-5" />

  <h3 class="mt-20 font-display text-2xl font-bold">Formatos de trabalho</h3>
  <WorkFormats class="mt-6" />
</Section>
