---
import Section from '../layout/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Card from '../ui/Card.astro';
import { steps, workFormats } from '../../data/process';
---

<Section id="processo">
  <SectionHeading
    eyebrow="Processo"
    title="Como funciona, da primeira conversa à entrega."
    description="Um caminho simples, com escopo combinado antes de começar e sem surpresas no meio."
  />

  <ol class="mt-12 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-5">
    {steps.map((step, index) => (
      <li class="border-t border-surface pt-5">
        <p class="font-mono text-sm text-brand-gradient">{String(index + 1).padStart(2, '0')}</p>
        <h3 class="mt-3 font-display text-lg font-bold">{step.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted">{step.description}</p>
      </li>
    ))}
  </ol>

  <h3 class="mt-20 font-display text-2xl font-bold">Formatos de trabalho</h3>
  <ul class="mt-6 grid gap-5 md:grid-cols-3">
    {workFormats.map((format) => (
      <Card as="li" class="p-6">
        <h4 class="font-display text-lg font-bold">{format.title}</h4>
        <p class="mt-2 text-sm leading-relaxed text-muted">{format.description}</p>
      </Card>
    ))}
  </ul>
</Section>
