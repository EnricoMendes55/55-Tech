---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/layout/Container.astro';
import Section from '../components/layout/Section.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import ContactChannels from '../components/ContactChannels.astro';
import ContactForm from '../components/ContactForm.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import { afterRequestSteps } from '../data/process';
---

<BaseLayout
  title="Contato"
  description="Solicite um orçamento à 55 Tech: conte sua necessidade e seu objetivo. Avaliamos cada solicitação e, havendo alinhamento, preparamos uma proposta."
>
  <Container class="pb-20 pt-10 sm:pb-28">
    <Breadcrumbs items={[{ label: 'Contato' }]} />
    <div class="mt-8 grid gap-12 lg:grid-cols-2">
      <div>
        <PageHeader
          eyebrow="Contato"
          title="Solicite um orçamento."
          description="Conte o que você precisa e qual é o seu objetivo. Nossa equipe avaliará sua solicitação e, quando houver alinhamento, preparará uma proposta personalizada."
        />
        <ContactChannels class="mt-8" />
      </div>
      {/* Âncora pública dos botões "Solicitar orçamento" (/contato/#formulario). */}
      <div id="formulario">
        <ContactForm />
      </div>
    </div>
  </Container>

  <Section tone="alt">
    <SectionHeading
      eyebrow="Depois da solicitação"
      title="O que acontece em seguida."
      description="Do primeiro contato ao início do projeto, você sabe quem está cuidando de cada etapa."
    />
    <ProcessSteps items={afterRequestSteps} class="mt-12 max-w-3xl" />
  </Section>
</BaseLayout>
