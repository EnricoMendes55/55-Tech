---
// Banner de consentimento. Só aparece quando existe um ID do GA4 em src/data/site.ts
// e o visitante ainda não escolheu. Sem ID, o site não rastreia nada e o banner nunca é exibido.
import Card from './ui/Card.astro';
import { url } from '../utils/url';
---

<Card
  id="consent-banner"
  role="region"
  aria-label="Consentimento de cookies"
  hidden
  class="fixed inset-x-4 bottom-4 z-50 mx-auto max-w-xl p-5 shadow-2xl"
>
  <p class="text-sm leading-relaxed text-muted">
    Usamos o Google Analytics para entender como o site é usado. Ele só é ativado se você aceitar.
    <a href={url('/privacidade/')} class="text-ice underline underline-offset-4">
      Saiba mais
    </a>
    .
  </p>
  <div class="mt-4 flex gap-3">
    <!-- Os valores de data-consent são os mesmos gravados no navegador; ver scripts/analytics.ts. -->
    <button
      type="button"
      data-consent="aceito"
      class="rounded-full bg-ice px-5 py-2 text-sm font-bold text-deep-black"
    >
      Aceitar
    </button>
    <button
      type="button"
      data-consent="recusado"
      class="rounded-full border border-surface px-5 py-2 text-sm font-bold text-ice"
    >
      Recusar
    </button>
  </div>
</Card>

<script>
  import { site } from '../data/site';
  import { loadGA4, readConsent, saveConsent, trackEvent } from '../scripts/analytics';

  const banner = document.querySelector<HTMLElement>('#consent-banner');

  if (site.ga4Id && banner) {
    const previousChoice = readConsent();
    if (previousChoice === 'aceito') loadGA4();
    if (previousChoice === null) banner.hidden = false;

    banner.querySelectorAll<HTMLButtonElement>('[data-consent]').forEach((button) => {
      button.addEventListener('click', () => {
        const accepted = button.dataset.consent === 'aceito';
        saveConsent(accepted ? 'aceito' : 'recusado');
        banner.hidden = true;
        // Recusar depois de ter aceitado exige recarregar para descarregar o GA4.
        if (accepted) loadGA4();
        else if (previousChoice === 'aceito') location.reload();
      });
    });

    document.querySelectorAll('[data-open-consent]').forEach((button) => {
      button.addEventListener('click', () => (banner.hidden = false));
    });
  }

  // Qualquer elemento com data-event="nome" vira um evento de conversão ao ser clicado.
  document.addEventListener('click', (event) => {
    const target = (event.target as HTMLElement).closest<HTMLElement>('[data-event]');
    if (target?.dataset.event) trackEvent(target.dataset.event);
  });
</script>
