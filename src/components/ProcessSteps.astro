---
// Etapas do processo, numeradas. `limit` mostra só as primeiras (ex.: em /contato/).
import { steps } from '../data/process';

interface Props {
  limit?: number;
  class?: string;
}

const { limit, class: className } = Astro.props;
const visibleSteps = limit ? steps.slice(0, limit) : steps;
---

<ol class:list={['grid gap-x-6 gap-y-10 sm:grid-cols-2', className]}>
  {visibleSteps.map((step, index) => (
    <li class="border-t border-surface pt-5">
      <p class="font-mono text-sm text-brand-gradient">{String(index + 1).padStart(2, '0')}</p>
      <h3 class="mt-3 font-display text-lg font-bold">{step.title}</h3>
      <p class="mt-2 text-sm leading-relaxed text-muted">{step.description}</p>
    </li>
  ))}
</ol>
