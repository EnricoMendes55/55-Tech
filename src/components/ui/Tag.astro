---
// Etiqueta pequena em fonte mono, para detalhes técnicos.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span
  class:list={[
    'inline-block rounded-full border border-surface px-3 py-1 font-mono text-xs text-muted',
    className,
  ]}
>
  <slot />
</span>
