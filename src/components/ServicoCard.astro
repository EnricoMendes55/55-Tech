---
import type { Servico } from '../data/servicos';

interface Props {
  servico: Servico;
}
const { servico } = Astro.props;
---

<article class="flex h-full flex-col rounded-2xl border border-surface bg-midnight p-7 transition hover:border-violet">
  <p class="font-mono text-sm text-marca">{servico.numero}</p>
  <h3 class="mt-4 font-display text-xl font-bold">{servico.titulo}</h3>
  <p class="mb-6 mt-3 leading-relaxed text-muted">{servico.descricao}</p>
  <p class="mt-auto border-t border-surface pt-5 text-sm leading-relaxed text-ice">
    <span class="mb-1 block font-mono text-xs uppercase tracking-widest text-lavender">Objetivo</span>
    {servico.objetivo}
  </p>
</article>
