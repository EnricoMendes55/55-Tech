---
import SectionHeading from '../ui/SectionHeading.astro';
import { site } from '../../data/site';
import { servicos, auditoria } from '../../data/servicos';
import { contatoPrincipal, linkInstagram } from '../../utils/contato';

const interesses = [...servicos.map((servico) => servico.titulo), auditoria.titulo, 'Ainda não sei'];
const campo =
  'mt-2 w-full rounded-xl border border-surface bg-deep-black px-4 py-3 text-ice placeholder:text-muted/60';
---

<section id="contato" class="mx-auto grid max-w-6xl gap-12 px-5 py-20 sm:px-8 sm:py-28 lg:grid-cols-2">
  <div>
    <SectionHeading
      etiqueta="Contato"
      titulo="Vamos conversar sobre o seu projeto?"
      descricao="Conte o que você precisa. A primeira conversa é sem compromisso."
    />

    <ul class="mt-8 space-y-4">
      <li>
        <a
          href={contatoPrincipal.href}
          data-evento={contatoPrincipal.evento}
          target="_blank"
          rel="noopener noreferrer"
          class="font-display text-xl font-bold text-marca"
        >
          {contatoPrincipal.rotulo} →
        </a>
      </li>
      {
        site.whatsapp && (
          <li>
            <a href={linkInstagram} data-evento="clique_instagram" target="_blank" rel="noopener noreferrer" class="text-muted transition hover:text-ice">
              Instagram: @{site.instagram}
            </a>
          </li>
        )
      }
      {
        site.email && (
          <li>
            <a href={`mailto:${site.email}`} data-evento="clique_email" class="text-muted transition hover:text-ice">
              {site.email}
            </a>
          </li>
        )
      }
    </ul>
  </div>

  {
    /* O formulário monta a mensagem e abre o WhatsApp, por isso só existe quando há número em site.ts. */
    site.whatsapp && (
      <form id="form-contato" class="rounded-2xl border border-surface bg-midnight p-6 sm:p-8">
        <div class="grid gap-5 sm:grid-cols-2">
          <label class="block text-sm font-medium">
            Nome
            <input type="text" name="nome" required autocomplete="name" class={campo} />
          </label>
          <label class="block text-sm font-medium">
            Empresa <span class="font-normal text-muted">(opcional)</span>
            <input type="text" name="empresa" autocomplete="organization" class={campo} />
          </label>
        </div>
        <label class="mt-5 block text-sm font-medium">
          Interesse
          <select name="interesse" class={campo}>
            {interesses.map((interesse) => <option>{interesse}</option>)}
          </select>
        </label>
        <label class="mt-5 block text-sm font-medium">
          Mensagem
          <textarea name="mensagem" required rows="4" class={campo} />
        </label>
        <button type="submit" class="bg-marca mt-6 w-full rounded-full px-6 py-3 text-sm font-bold text-deep-black transition hover:brightness-110">
          Enviar pelo WhatsApp
        </button>
        <p class="mt-3 text-center text-xs text-muted">
          Ao enviar, o WhatsApp abre com a mensagem pronta. Nada é armazenado neste site.
        </p>
      </form>
    )
  }
</section>

<script>
  import { linkWhatsapp } from '../../utils/contato';
  import { registrarEvento } from '../../scripts/analytics';

  const form = document.querySelector<HTMLFormElement>('#form-contato');

  // Limpa o erro personalizado assim que a pessoa volta a digitar.
  form?.addEventListener('input', (evento) => {
    (evento.target as HTMLInputElement).setCustomValidity('');
  });

  form?.addEventListener('submit', (evento) => {
    evento.preventDefault();
    const dados = new FormData(form);
    const texto = (nome: string) => String(dados.get(nome) ?? '').trim();

    // `required` aceita campos só com espaços; aqui eles contam como vazios.
    for (const nome of ['nome', 'mensagem']) {
      const campo = form.elements.namedItem(nome) as HTMLInputElement | HTMLTextAreaElement;
      campo.setCustomValidity(texto(nome) ? '' : 'Preencha este campo.');
    }
    if (!form.reportValidity()) return;

    const empresa = texto('empresa');
    const mensagem = [
      `Olá! Sou ${texto('nome')}${empresa ? `, da ${empresa}` : ''}.`,
      `Interesse: ${texto('interesse')}`,
      '',
      texto('mensagem'),
    ].join('\n');

    window.open(linkWhatsapp(mensagem), '_blank', 'noopener');
    registrarEvento('envio_formulario', { interesse: texto('interesse') });
  });
</script>
