---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/layout/Container.astro';
import Section from '../components/layout/Section.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import CallToAction from '../components/CallToAction.astro';
import { differentiators } from '../data/about';
import { url } from '../utils/url';
---

<BaseLayout
  title="Quem somos"
  description="A 55 Tech une estratégia, design e desenvolvimento para que cada entrega resolva um problema real da sua empresa. Conheça como trabalhamos."
>
  <Container class="pb-20 pt-10 sm:pb-28">
    <Breadcrumbs items={[{ label: 'Quem somos' }]} />
    <div class="mt-8">
      <PageHeader
        eyebrow="Sobre a 55 Tech"
        title="Tecnologia a serviço do negócio."
        description="A 55 Tech une estratégia, design e desenvolvimento para que cada entrega resolva um problema real da sua empresa."
      />
    </div>

    <div class="mt-16 grid gap-12 lg:grid-cols-2">
      <div>
        <h2 class="font-display text-2xl font-bold">
          Tecnologia com propósito. Projetos com atenção de verdade.
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-muted">
          A 55 Tech é um estúdio de soluções digitais que une estratégia, design e desenvolvimento
          para ajudar empresas a evoluir por meio da tecnologia.
        </p>
        <p class="mt-4 text-lg leading-relaxed text-muted">
          Trabalhamos com uma estrutura independente e uma atuação próxima, acompanhando cada
          projeto desde o entendimento do problema até a entrega da solução.
        </p>
        <p class="mt-4 text-lg leading-relaxed text-muted">
          Nosso foco está em quatro frentes: presença digital, sistemas e soluções personalizadas,
          design de produtos e performance digital.
        </p>
        <p class="mt-4 text-lg leading-relaxed text-muted">
          Acreditamos que um bom projeto começa com uma conversa clara, objetivos bem definidos e
          escolhas técnicas que façam sentido para cada negócio.
        </p>
        <p class="mt-4 text-lg leading-relaxed text-muted">
          Por isso, valorizamos a transparência, o cuidado com os detalhes e a construção de
          soluções que sejam úteis, eficientes e possíveis de manter e evoluir.
        </p>
        <p class="mt-4 text-lg leading-relaxed text-muted">
          O próprio site da 55 Tech reflete essa filosofia: uma experiência rápida, acessível,
          responsiva e construída com atenção à qualidade técnica.
        </p>
        <p class="mt-6">
          <a href={url('/servicos/')} class="font-bold text-cyan hover:underline">
            Conheça os serviços →
          </a>
        </p>
      </div>

      <div>
        <h2 class="font-display text-2xl font-bold">O que nos guia</h2>
        <ul class="mt-6 grid gap-x-8 gap-y-8 sm:grid-cols-2">
          {differentiators.map((item) => (
            <li class="border-l-2 border-violet pl-5">
              <h3 class="font-display text-lg font-bold">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{item.description}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Container>

  <Section tone="alt">
    <SectionHeading
      eyebrow="Processo"
      title="Como funciona, da primeira conversa à entrega."
      description="Um caminho simples, com escopo combinado antes de começar e sem surpresas no meio."
    />
    <ProcessSteps class="mt-12 lg:grid-cols-5" />
  </Section>

  <CallToAction />
</BaseLayout>
