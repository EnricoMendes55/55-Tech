---
import { Image } from 'astro:assets';
import logo from '../assets/logo-55.png';
import Button from './ui/Button.astro';
import Container from './layout/Container.astro';
import { navigation } from '../data/site';
import { getDirectContact, getQuoteHref, quoteRequest } from '../utils/contact';
import { getPageName } from '../utils/pages';
import { getCurrentState, url } from '../utils/url';

const currentPath = Astro.url.pathname;
const quoteHref = getQuoteHref();
const directContact = getDirectContact(await getPageName(currentPath));
---

<header class="sticky top-0 z-40 border-b border-surface/60 bg-deep-black/85 backdrop-blur">
  <Container class="flex items-center justify-between gap-4 py-3 sm:gap-6">
    <a href={url('/')} class="flex items-center gap-3" aria-label="55 Tech, página inicial">
      <Image src={logo} alt="" width={124} class="h-9 w-auto" loading="eager" />
      <span class="font-display text-sm font-medium tracking-[0.35em] text-ice">TECH</span>
    </a>

    <nav aria-label="Principal" class="hidden md:block">
      <ul class="flex items-center gap-7 text-sm font-medium text-muted">
        {navigation.map((item) => (
          <li>
            <a
              href={url(item.path)}
              aria-current={getCurrentState(item.path, currentPath)}
              class="transition hover:text-ice aria-[current]:text-ice"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      {/*
          Orçamento no cabeçalho: rótulo completo a partir de 640 px; "Orçamento" entre 360 e
          639 px; abaixo de 360 px (22,5rem, que acompanha o tamanho de letra do navegador) não
          cabe ao lado do logo e fica só no menu. O nome acessível é sempre o completo.
        */}
      <Button
        href={quoteHref}
        event={quoteRequest.event}
        ariaLabel={quoteRequest.label}
        class="py-2.5 max-[22.5rem]:hidden max-sm:px-4 sm:px-5"
      >
        <span class="sm:hidden">{quoteRequest.shortLabel}</span>
        <span class="hidden sm:inline">{quoteRequest.label}</span>
      </Button>

      <button
        id="menu-button"
        type="button"
        class="rounded-lg border border-stroke p-2.5 md:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir menu"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M3 6h14M3 10h14M3 14h14"></path>
        </svg>
      </button>
    </div>
  </Container>

  <nav
    id="mobile-menu"
    aria-label="Principal (celular)"
    class="hidden border-t border-surface/60 md:hidden"
  >
    <Container as="ul" class="py-3">
      {navigation.map((item) => (
        <li>
          <a
            href={url(item.path)}
            aria-current={getCurrentState(item.path, currentPath)}
            class="block py-3 font-medium text-ice"
          >
            {item.label}
          </a>
        </li>
      ))}
      <li class="mt-2 flex flex-col items-start gap-1 border-t border-surface/60 pt-4">
        <Button href={quoteHref} event={quoteRequest.event} wrap>
          {quoteRequest.label}
        </Button>
        <a
          href={directContact.href}
          data-event={directContact.event}
          target="_blank"
          rel="noopener noreferrer"
          class="block py-3 font-medium text-ice"
        >
          {directContact.label}
        </a>
      </li>
    </Container>
  </nav>
</header>

<script>
  // Abre e fecha o menu no celular.
  const button = document.querySelector<HTMLButtonElement>('#menu-button');
  const panel = document.querySelector<HTMLElement>('#mobile-menu');

  function setOpen(open: boolean) {
    panel?.classList.toggle('hidden', !open);
    button?.setAttribute('aria-expanded', String(open));
    button?.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
  }

  const isOpen = () => button?.getAttribute('aria-expanded') === 'true';

  button?.addEventListener('click', () => setOpen(!isOpen()));
  panel?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) setOpen(false);
  });

  // Esc fecha o menu e devolve o foco ao botão, para quem navega pelo teclado não se perder.
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && isOpen()) {
      setOpen(false);
      button?.focus();
    }
  });
</script>
