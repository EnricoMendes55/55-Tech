---
import Section from '../layout/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import ServiceGrid from '../ServiceGrid.astro';
---

<Section id="servicos">
  <SectionHeading
    eyebrow="Serviços"
    title="Quatro frentes, um objetivo: melhorar o seu negócio."
    description="Do primeiro site ao sistema sob medida, cada serviço parte de um problema concreto da sua empresa."
  />

  <div class="mt-12">
    <ServiceGrid contactPath="/#contato" />
  </div>
</Section>
