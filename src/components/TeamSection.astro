---
// Seção Equipe de /quem-somos/: um card por pessoa, com as iniciais no lugar da foto.
// Os dados ficam em src/data/team.ts.
import Section from './layout/Section.astro';
import Card from './ui/Card.astro';
import SectionHeading from './ui/SectionHeading.astro';
import { team, teamSection } from '../data/team';
---

<Section class="border-t border-surface/60">
  <SectionHeading eyebrow={teamSection.eyebrow} title={teamSection.title} />
  <ul class="mt-12 grid gap-5 md:grid-cols-3">
    {team.map((member) => (
      <Card as="li" class="p-7">
        <span
          class="bg-action-gradient flex size-14 items-center justify-center rounded-full font-display text-lg font-bold text-deep-black"
          aria-hidden="true"
        >
          {member.initials}
        </span>
        <h3 class="mt-5 font-display text-xl font-bold">{member.name}</h3>
        <p class="mt-1 font-mono text-xs uppercase tracking-widest text-lavender">{member.role}</p>
        <p class="mt-4 text-sm leading-relaxed text-muted">{member.description}</p>
      </Card>
    ))}
  </ul>
</Section>
