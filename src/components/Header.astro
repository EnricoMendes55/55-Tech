---
import { Image } from 'astro:assets';
import logo from '../assets/logo-55.png';
import Button from './ui/Button.astro';
import { menu } from '../data/site';
import { contatoPrincipal } from '../utils/contato';
import { url } from '../utils/url';
---

<header class="sticky top-0 z-40 border-b border-surface/60 bg-deep-black/85 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-5 py-3 sm:px-8">
    <a href={url('/')} class="flex items-center gap-3" aria-label="55 Tech, página inicial">
      <Image src={logo} alt="" width={124} class="h-9 w-auto" loading="eager" />
      <span class="font-display text-sm font-medium tracking-[0.35em] text-ice">TECH</span>
    </a>

    <nav aria-label="Principal" class="hidden md:block">
      <ul class="flex items-center gap-7 text-sm font-medium text-muted">
        {
          menu.map((item) => (
            <li>
              <a href={url(`/#${item.ancora}`)} class="transition hover:text-ice">
                {item.rotulo}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <div class="hidden sm:block">
        <Button href={contatoPrincipal.href} evento={contatoPrincipal.evento} externo class="px-5 py-2.5">
          {contatoPrincipal.rotulo}
        </Button>
      </div>

      <button
        id="botao-menu"
        type="button"
        class="rounded-lg border border-surface p-2.5 md:hidden"
        aria-expanded="false"
        aria-controls="menu-mobile"
        aria-label="Abrir menu"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M3 6h14M3 10h14M3 14h14"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav id="menu-mobile" aria-label="Principal (celular)" class="hidden border-t border-surface/60 md:hidden">
    <ul class="mx-auto max-w-6xl px-5 py-3 sm:px-8">
      {
        menu.map((item) => (
          <li>
            <a href={url(`/#${item.ancora}`)} class="block py-3 font-medium text-ice">
              {item.rotulo}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  // Abre e fecha o menu no celular.
  const botao = document.querySelector<HTMLButtonElement>('#botao-menu');
  const painel = document.querySelector<HTMLElement>('#menu-mobile');

  function alternar(aberto: boolean) {
    painel?.classList.toggle('hidden', !aberto);
    botao?.setAttribute('aria-expanded', String(aberto));
    botao?.setAttribute('aria-label', aberto ? 'Fechar menu' : 'Abrir menu');
  }

  botao?.addEventListener('click', () => alternar(botao.getAttribute('aria-expanded') !== 'true'));
  painel?.addEventListener('click', (evento) => {
    if ((evento.target as HTMLElement).closest('a')) alternar(false);
  });
</script>
