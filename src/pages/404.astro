---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import { url } from '../utils/url';
---

<BaseLayout titulo="Página não encontrada" naoIndexar>
  <section class="mx-auto max-w-6xl px-5 py-32 text-center sm:px-8">
    <p class="font-display text-7xl font-bold text-marca">404</p>
    <h1 class="mt-4 font-display text-3xl font-bold">Esta página não existe.</h1>
    <p class="mt-4 text-muted">O endereço pode ter mudado ou sido digitado errado.</p>
    <Button href={url('/')} class="mt-8">Voltar para o início</Button>
  </section>
</BaseLayout>
