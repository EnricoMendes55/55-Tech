---
// Canais de contato: o principal em destaque, depois Instagram e e-mail quando houver.
import { site } from '../data/site';
import { getDirectContact, instagramUrl } from '../utils/contact';
import { getPageName } from '../utils/pages';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const directContact = getDirectContact(await getPageName(Astro.url.pathname));
---

<ul class:list={['space-y-4', className]}>
  <li>
    <a
      href={directContact.href}
      data-event={directContact.event}
      target="_blank"
      rel="noopener noreferrer"
      class="font-display text-xl font-bold text-brand-gradient"
    >
      {directContact.label} →
    </a>
  </li>
  {site.whatsapp && (
    <li>
      <a
        href={instagramUrl}
        data-event="instagram_click"
        target="_blank"
        rel="noopener noreferrer"
        class="text-muted transition hover:text-ice"
      >
        Instagram: @{site.instagram}
      </a>
    </li>
  )}
  {site.email && (
    <li>
      <a
        href={`mailto:${site.email}`}
        data-event="email_click"
        class="text-muted transition hover:text-ice"
      >
        {site.email}
      </a>
    </li>
  )}
</ul>
