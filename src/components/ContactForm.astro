---
// Formulário de orçamento: monta a mensagem e abre o WhatsApp. Nada é enviado a servidor nem
// guardado. Só existe quando há número em site.ts. Use no máximo um por página (o script busca
// #contact-form). Textos em src/data/contactForm.ts.
import Card from './ui/Card.astro';
import { contactForm as text, quoteMessage } from '../data/contactForm';
import { site } from '../data/site';
import { integratedSolutionSlug } from '../utils/contact';
import { getPageName } from '../utils/pages';
import { getAuditOffer, getServices } from '../utils/services';

const services = await getServices();
const audit = await getAuditOffer();
const { openings } = quoteMessage;

// `slug` é o valor aceito em ?servico= para deixar a opção selecionada (ver o script abaixo).
// `opening` é a primeira linha da mensagem quando a opção é escolhida.
const interests: { label: string; slug?: string; opening: string }[] = [
  ...services.map((entry) => ({
    label: entry.data.title,
    slug: entry.id,
    opening: openings.default,
  })),
  { label: audit.data.title, slug: audit.id, opening: openings.audit },
  { label: text.integratedSolution, slug: integratedSolutionSlug, opening: openings.default },
  { label: text.unsure, opening: openings.unsure },
];
const pageName = await getPageName(Astro.url.pathname);

const labelClass = 'block text-sm font-medium';
const fieldClass =
  'mt-2 w-full rounded-xl border border-stroke bg-deep-black px-4 py-3 text-ice placeholder:text-muted/60';
---

{site.whatsapp && (
  <Card
    as="form"
    id="contact-form"
    class="p-6 sm:p-8"
    novalidate
    data-page={pageName}
    data-error-required={text.errors.required}
    data-error-select={text.errors.select}
  >
    <div class="grid gap-5 sm:grid-cols-2">
      <label class={labelClass}>
        {text.labels.name}
        <input type="text" name="name" required autocomplete="name" class={fieldClass} />
      </label>
      <label class={labelClass}>
        {text.labels.company} <span class="font-normal text-muted">{text.optional}</span>
        <input type="text" name="company" autocomplete="organization" class={fieldClass} />
      </label>
    </div>
    <label class:list={[labelClass, 'mt-5']}>
      {text.labels.service}
      <select name="interest" required class={fieldClass}>
        <option value="" disabled selected>
          {text.servicePlaceholder}
        </option>
        {interests.map((interest) => (
          <option data-slug={interest.slug} data-opening={interest.opening}>
            {interest.label}
          </option>
        ))}
      </select>
    </label>
    <label class:list={[labelClass, 'mt-5']}>
      {text.labels.need}
      <textarea
        name="need"
        required
        rows="4"
        placeholder={text.needPlaceholder}
        class={fieldClass}
      />
    </label>
    <label class:list={[labelClass, 'mt-5']}>
      {text.labels.deadline} <span class="font-normal text-muted">{text.optional}</span>
      <select name="deadline" class={fieldClass}>
        <option value="" selected>
          {text.deadlinePlaceholder}
        </option>
        {text.deadlines.map((deadline) => (
          <option>{deadline}</option>
        ))}
      </select>
    </label>
    <label class:list={[labelClass, 'mt-5']}>
      {text.labels.website} <span class="font-normal text-muted">{text.optional}</span>
      <input
        type="text"
        name="website"
        autocomplete="url"
        placeholder={text.websitePlaceholder}
        aria-describedby="website-hint"
        class={fieldClass}
      />
    </label>
    <p id="website-hint" class="mt-2 text-sm text-muted">
      {text.websiteHint}
    </p>
    <button
      type="submit"
      class="bg-action-gradient mt-6 w-full rounded-full px-6 py-3 text-sm font-bold text-deep-black transition hover:brightness-110"
    >
      {text.submit}
    </button>
    <p class="mt-3 text-center text-xs text-muted">{text.note}</p>
  </Card>
)}

<script>
  import { getWhatsAppUrl } from '../utils/contact';
  import { trackEvent } from '../scripts/analytics';
  import { buildQuoteMessage } from '../scripts/quoteMessage';

  const form = document.querySelector<HTMLFormElement>('#contact-form');

  if (form) {
    const select = form.elements.namedItem('interest') as HTMLSelectElement;
    const { page, errorRequired = '', errorSelect = '' } = form.dataset;

    // ?servico=landing-pages deixa o assunto já selecionado. Só vale um valor que corresponda
    // exatamente a uma opção existente; qualquer outro mantém "Selecione uma opção". O valor
    // recebido só escolhe uma opção: nunca é escrito na página nem na mensagem.
    const requested = new URLSearchParams(location.search).getAll('servico');
    if (requested.length === 1) {
      const option = [...select.options].find((item) => item.dataset.slug === requested[0]);
      if (option) select.value = option.value;
    }

    // Campos obrigatórios e a mensagem de cada um. A validação é feita aqui (o form tem
    // `novalidate`) para que espaços contem como vazio e os textos sejam sempre os aprovados.
    const required: Record<string, string> = {
      name: errorRequired,
      interest: errorSelect,
      need: errorRequired,
    };

    const setError = (
      field: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement,
      error: string,
    ) => {
      field.setCustomValidity(error);
      if (error) field.setAttribute('aria-invalid', 'true');
      else field.removeAttribute('aria-invalid');
    };

    // O erro de um campo some assim que a pessoa volta a mexer nele.
    const clearError = (event: Event) => setError(event.target as HTMLInputElement, '');
    form.addEventListener('input', clearError);
    form.addEventListener('change', clearError);

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const value = (name: string) => String(data.get(name) ?? '').trim();

      for (const [name, error] of Object.entries(required)) {
        const field = form.elements.namedItem(name) as HTMLInputElement;
        setError(field, value(name) ? '' : error);
      }
      // Mostra o primeiro erro no próprio campo e leva o foco até ele. Nada do que foi
      // digitado é apagado.
      if (!form.reportValidity()) return;

      const message = buildQuoteMessage({
        opening: select.selectedOptions[0].dataset.opening ?? '',
        name: value('name'),
        company: value('company'),
        service: value('interest'),
        deadline: value('deadline'),
        website: value('website'),
        need: value('need'),
        page,
      });

      window.open(getWhatsAppUrl(message), '_blank', 'noopener');
      trackEvent('contact_form_submit', { interest: value('interest') });
    });
  }
</script>
