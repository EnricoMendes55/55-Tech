---
import Section from '../layout/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import ServiceCard from '../ServiceCard.astro';
import { auditOffer, services } from '../../data/services';
import { url } from '../../utils/url';
---

<Section id="servicos">
  <SectionHeading
    eyebrow="Serviços"
    title="Quatro frentes, um objetivo: melhorar o seu negócio."
    description="Do primeiro site ao sistema sob medida, cada serviço parte de um problema concreto da sua empresa."
  />

  <ul class="mt-12 grid gap-5 md:grid-cols-2">
    {services.map((service) => (
      <li>
        <ServiceCard service={service} />
      </li>
    ))}
  </ul>

  <aside class="border-brand-gradient mt-5 flex flex-col gap-6 rounded-2xl p-7 md:flex-row md:items-center md:justify-between">
    <div class="max-w-2xl">
      <Eyebrow>Por onde começar</Eyebrow>
      <h3 class="mt-3 font-display text-2xl font-bold">{auditOffer.title}</h3>
      <p class="mt-3 leading-relaxed text-muted">{auditOffer.description}</p>
      <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-1 text-sm text-ice">
        {auditOffer.deliverables.map((deliverable) => (
          <li>+ {deliverable}</li>
        ))}
      </ul>
    </div>
    <Button href={url('/#contato')} variant="secondary" class="shrink-0">
      Pedir uma auditoria
    </Button>
  </aside>
</Section>
