---
import { Image } from 'astro:assets';
import logo from '../assets/logo-horizontal.png';
import { navigation, site } from '../data/site';
import { instagramUrl } from '../utils/contact';
import { url } from '../utils/url';

const year = new Date().getFullYear();
---

<footer class="border-t border-surface/60 bg-deep-black">
  <div class="mx-auto flex max-w-6xl flex-col gap-8 px-5 py-12 sm:px-8 md:flex-row md:items-start md:justify-between">
    <div>
      <Image src={logo} alt="55 Tech — Soluções digitais" width={400} class="h-14 w-auto" />
      <p class="mt-4 max-w-xs text-sm text-muted">{site.tagline}</p>
    </div>

    <nav aria-label="Rodapé">
      <ul class="grid grid-cols-2 gap-x-10 gap-y-3 text-sm text-muted">
        {navigation.map((item) => (
          <li>
            <a href={url(`/#${item.anchor}`)} class="transition hover:text-ice">
              {item.label}
            </a>
          </li>
        ))}
        <li>
          <a
            href={instagramUrl}
            data-event="instagram_click"
            target="_blank"
            rel="noopener noreferrer"
            class="transition hover:text-ice"
          >
            Instagram
          </a>
        </li>
      </ul>
    </nav>
  </div>

  <div class="border-t border-surface/60">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-5 py-5 font-mono text-xs text-muted sm:px-8">
      <p>
        © {year} {site.name}
      </p>
      <div class="flex gap-6">
        <a href={url('/privacidade/')} class="transition hover:text-ice">
          Privacidade
        </a>
        {site.ga4Id && (
          <button type="button" data-open-consent class="transition hover:text-ice">
            Preferências de cookies
          </button>
        )}
      </div>
    </div>
  </div>
</footer>
