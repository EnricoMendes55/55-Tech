---
// Moldura de todas as páginas: <head> com SEO, cabeçalho, rodapé e banner de consentimento.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { site } from '../data/site';
import { instagramUrl } from '../utils/contact';
import { url } from '../utils/url';

interface Props {
  title?: string;
  description?: string;
  /** true em páginas que não devem aparecer no Google (ex.: 404). */
  noIndex?: boolean;
  /** Dados estruturados extras da página (ex.: Service), além do Organization padrão. */
  structuredData?: Record<string, unknown>[];
}

const { title, description = site.description, noIndex = false, structuredData = [] } = Astro.props;

const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.tagline}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url('/og.png'), Astro.site);

// Dados estruturados: ajudam buscadores a entender quem é a empresa.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  description: site.description,
  url: new URL(url('/'), Astro.site).href,
  logo: new URL(url('/favicon.png'), Astro.site).href,
  sameAs: [instagramUrl],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {/* Página fora do índice (ex.: 404) não declara endereço canônico. */}
    {!noIndex && <link rel="canonical" href={canonicalUrl} />}
    {noIndex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/png" href={url('/favicon.png')} />
    <meta name="theme-color" content="#090a14" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {structuredData.map((data) => (
      <script type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}
  </head>
  <body class="antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-ice focus:px-4 focus:py-2 focus:text-deep-black"
    >
      Pular para o conteúdo
    </a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <ConsentBanner />
  </body>
</html>
