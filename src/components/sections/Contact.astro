---
import Section from '../layout/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import ContactChannels from '../ContactChannels.astro';
import ContactForm from '../ContactForm.astro';
---

<Section id="contato" class="grid gap-12 lg:grid-cols-2">
  <div>
    <SectionHeading
      eyebrow="Contato"
      title="Vamos conversar sobre o seu projeto?"
      description="Conte o que você precisa e qual é o seu objetivo. A primeira conversa é sem compromisso."
    />
    <ContactChannels class="mt-8" />
  </div>
  <ContactForm />
</Section>
