---
// Bloco final das páginas internas: convite para conversar, com WhatsApp e a página de contato.
import Section from './layout/Section.astro';
import Button from './ui/Button.astro';
import Eyebrow from './ui/Eyebrow.astro';
import { primaryContact } from '../utils/contact';
import { url } from '../utils/url';
---

<Section>
  <div class="border-brand-gradient rounded-2xl p-8 sm:p-12">
    <Eyebrow>Próximo passo</Eyebrow>
    <h2 class="mt-3 max-w-2xl font-display text-3xl font-bold tracking-tight sm:text-4xl">
      Vamos conversar sobre o seu projeto?
    </h2>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">
      Conte o que você precisa. A primeira conversa é sem compromisso.
    </p>
    <div class="mt-8 flex flex-wrap gap-4">
      <Button href={primaryContact.href} event={primaryContact.event} external>
        {primaryContact.label}
      </Button>
      <Button href={url('/contato/')} variant="secondary">
        Ver formas de contato
      </Button>
    </div>
  </div>
</Section>
