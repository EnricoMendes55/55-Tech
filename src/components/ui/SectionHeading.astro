---
// Cabeçalho padrão das seções: etiqueta mono (eyebrow), título e descrição opcional.
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
}
const { eyebrow, title, description } = Astro.props;
---

<div class="max-w-2xl">
  <p class="font-mono text-xs uppercase tracking-[0.2em] text-cyan">{eyebrow}</p>
  <h2 class="mt-3 font-display text-3xl font-bold tracking-tight sm:text-4xl">{title}</h2>
  {description && <p class="mt-4 text-lg leading-relaxed text-muted">{description}</p>}
</div>
