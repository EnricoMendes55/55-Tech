---
// Cabeçalho das páginas internas: etiqueta, o <h1> da página e descrição opcional.
import Eyebrow from '../ui/Eyebrow.astro';

interface Props {
  eyebrow: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<div class="max-w-3xl">
  <Eyebrow>{eyebrow}</Eyebrow>
  <h1 class="mt-3 font-display text-4xl font-bold tracking-tight">{title}</h1>
  {description && <p class="mt-4 text-lg leading-relaxed text-muted">{description}</p>}
</div>
