---
import { Image } from 'astro:assets';
import logo from '../assets/logo-horizontal.png';
import Container from './layout/Container.astro';
import { navigation, site } from '../data/site';
import { instagramUrl } from '../utils/contact';
import { isCurrentPage, url } from '../utils/url';

const year = new Date().getFullYear();
const currentPath = Astro.url.pathname;
---

<footer class="border-t border-surface/60 bg-deep-black">
  <Container class="flex flex-col gap-8 py-12 md:flex-row md:items-start md:justify-between">
    <div>
      <Image src={logo} alt="55 Tech — Soluções digitais" width={400} class="h-14 w-auto" />
      <p class="mt-4 max-w-xs text-sm text-muted">{site.tagline}</p>
    </div>

    <nav aria-label="Rodapé">
      <!-- py-1 nos links + gap-y-1 e -my-1: área de toque de 28 px sem mudar a posição do texto. -->
      <ul class="-my-1 grid grid-cols-2 gap-x-10 gap-y-1 text-sm text-muted">
        {navigation.map((item) => (
          <li>
            <a
              href={url(item.path)}
              aria-current={isCurrentPage(item.path, currentPath) ? 'page' : undefined}
              class="inline-block py-1 transition hover:text-ice"
            >
              {item.label}
            </a>
          </li>
        ))}
        <li>
          <a
            href={instagramUrl}
            data-event="instagram_click"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block py-1 transition hover:text-ice"
          >
            Instagram
          </a>
        </li>
      </ul>
    </nav>
  </Container>

  <div class="border-t border-surface/60">
    <Container class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-5 font-mono text-xs text-muted">
      <p>
        © {year} {site.name}
      </p>
      <div class="-my-1 flex gap-6">
        <a
          href={url('/privacidade/')}
          aria-current={isCurrentPage('/privacidade/', currentPath) ? 'page' : undefined}
          class="inline-block py-1 transition hover:text-ice"
        >
          Privacidade
        </a>
        {site.ga4Id && (
          <button type="button" data-open-consent class="py-1 transition hover:text-ice">
            Preferências de cookies
          </button>
        )}
      </div>
    </Container>
  </div>
</footer>
